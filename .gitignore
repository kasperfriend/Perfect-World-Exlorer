# Lossless runtime terrain backing store (rebuildable client data)
/cache/

# Vendored AMD FSR SDK 2.4.0 DX12 runtime (MIT, redistributable with notice;
# see THIRD_PARTY_NOTICES.md). Everything else under sdk/ stays ignored —
# NVIDIA proprietary DLLs are never committed, and any other vendor files stay out.
/sdk/*
!/sdk/amd_fidelityfx_loader_dx12.dll
!/sdk/amd_fidelityfx_upscaler_dx12.dll
!/sdk/amd_fidelityfx_framegeneration_dx12.dll
!/sdk/AMD_FidelityFX-SDK-2.4.0-notices.md
!/sdk/AMD_FidelityFX-SDK-2.4.0-LICENSE.md
# The FidelityFX SDK API headers used by the FFI integration (MIT-style,
# same license terms as the binaries above; kept for reference and review).
!/sdk/include/
!/sdk/include/**
